{
  "manifest_version": 3,
  "name": "GDH 機械情報 拡張検索",
  "version": "1.20.8",
  "description": "GDHの機械情報CSVを取り込み、AND・ORの複合条件で検索します。",
  "permissions": [
    "storage",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GDH 拡張検索"
  },
  "content_scripts": [
    {
      "matches": [
        "https://global-service.fa-cnc.idc-t.melco.co.jp/cncservice/*"
      ],
      "js": [
        "gdh-export.js",
        "home-csv.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "viewer.css",
        "viewer.js",
        "worker.js",
        "bridge.js",
        "update-ui.js",
        "update.css"
      ],
      "matches": [
        "https://global-service.fa-cnc.idc-t.melco.co.jp/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'"
  },
  "host_permissions": [
    "https://global-service.fa-cnc.idc-t.melco.co.jp/cncservice/*",
    "https://github.com/yoshidak1121-cmd/GDH_search/releases/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
