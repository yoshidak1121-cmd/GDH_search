{
  "manifest_version": 3,
  "name": "GDH 機械情報 拡張検索",
  "version": "1.4.0",
  "description": "GDHの機械情報CSVを取り込み、AND・ORの複合条件で検索します。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "GDH 拡張検索"
  },
  "content_scripts": [
    {
      "matches": [
        "https://global-service.fa-cnc.idc-t.melco.co.jp/cncservice/*"
      ],
      "js": [
        "gdh-export.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "viewer.html",
        "viewer.css",
        "viewer.js",
        "worker.js",
        "bridge.js"
      ],
      "matches": [
        "https://global-service.fa-cnc.idc-t.melco.co.jp/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; worker-src 'self'"
  }
}
