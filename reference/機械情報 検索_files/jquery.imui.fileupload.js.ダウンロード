                }
                options.maxNumberOfFiles += operand;
                // 0 以下になったら 0 に戻します。ファイルの数は 0 を含めた自然数のはず。
                // 負の値になったら、exceedmaxnumberoffiles を true にし、_hasError でエラーメッセージを表示させます。
