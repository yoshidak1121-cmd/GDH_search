/**
 * 指定されたメッセージを表示します。
 * <br/>
 * <br/>
 * @param {String} message 表示するメッセージ
 * @param {String|String[]} [detail] 表示するメッセージ。8.0.8 から指定できるようになりました。
 * @param {Boolean} [closable=true] メッセージ表示領域を明示的に閉じることができるかどうかのフラグ。durationが0以下の場合強制的にtrueになります。 (true: クリックで閉じる、false: クリックしても閉じない）
 * @param {Number} [duration=10000] メッセージ表示領域が自動的に閉じるまでの時間。0 を指定すると自動的に閉じないようになります。 (ms)
 * @param {Boolean} [escape=false] メッセージをエスケープするかどうかのフラグ。(true: エスケープする、false: エスケープしない）
 * @example
 * imuiShowSuccessMessage('成功しました');
 * @example
 * // クリックするまで消えないようにする
 * imuiShowSuccessMessage('成功しました', true, 0);
 * @example
 * // メッセージをエスケープする
 * imuiShowSuccessMessage('&lt;sample.png&gt;を登録しました', true, 10000, true);
 * @example
 * // 詳細なメッセージを指定
 * imuiShowSuccessMessage('成功しました。作成したIDは以下の通りです。', ['IDxxx', 'IDyyy', 'IDzzz']);
 * @example
 * // 詳細なメッセージをエスケープする
 * imuiShowSuccessMessage('&lt;png&gt;を登録しました。', ['&lt;xxx.png&gt;', 'yyy.png', 'zzz.png'], true, 10000, true);
 * @class
 */
function imuiShowSuccessMessage(message, detail, closable, duration, escape) {
    var options = {};
    if (detail instanceof Array || typeof(detail) === 'string') {
      options.detail = detail;
    } else if (typeof(detail) === 'boolean') {
      options.closable = detail;
    }
    if (typeof(closable) === 'boolean') {
      options.closable = closable;
    } else if (typeof(closable) === 'number') {
      options.duration = closable;
    }
    if (typeof(duration) === 'number') {
      options.duration = duration;
    } else if (typeof(duration) === 'boolean') {
      options.escape = duration;
    }
    if (typeof(escape) === 'boolean') options.escape = escape;
    jQuery.imuiFormUtil.showSuccessMessage(message, options);
    /**
     * 成功メッセージを閉じます。<br>
     * im_ui 8.0.13 以降のバージョンで利用できます。
     * @memberOf imuiShowSuccessMessage#
     * @example
     * &lt;script&gt;
     *   $(function(){
     *     $(&#039;#success&#039;).on(&#039;click&#039;,function(){
     *       imuiShowSuccessMessage(&#039;title&#039;,&#039;detail&#039;); // 成功メッセージを表示
     *     })
     *     $(&#039;#close&#039;).on(&#039;click&#039;,function(){
     *       imuiShowSuccessMessage.close(); // 成功メッセージを閉じる
     *     })
     *   })
     * &lt;/script&gt;
     * &lt;button id=&quot;success&quot;&gt;show success&lt;/button&gt;
     * &lt;button id=&quot;close&quot;&gt;close message&lt;/button&gt;
     * 
     */
    imuiShowSuccessMessage.close = function(){
        var messagebox = $('#imui-messagebox');
        if (messagebox.is(':visible')) {
            messagebox.hide();
        }
    }
}

