/** 
 * <iframe src="..." data-imui_hide_header="true"> という iframe が存在する場合
 *
 * 1. iframe の高さを画面の高さにします
 * 2. iframe の中のコンテンツから #imui-header, #imui-footer を隠します。
 * 3. iframe の中のコンテンツの body の最小幅を 0px にします。
 */
(function($) {
  var HIDE_HEADER_KEY = 'imui_hide_header';
  function setIFrameHeight() {
    $('iframe').each(function() {
      if ($(this).data(HIDE_HEADER_KEY)) {
        var contentHeight = imuiTheme.content.getHeight();
        $(this).height(contentHeight);
      }
    });
  }

  $(document).ready(function() {
    $(window).on('resize', setIFrameHeight);
    setIFrameHeight();

    try {
      if (window.frameElement !== null && $(window.frameElement).data(HIDE_HEADER_KEY)) {
        $('#imui-header').hide();
        $('#imui-footer').hide();
        $('body').css('min-width', 0);
      }
    } catch(ignore) {
    }
  });
})(jQuery);

var imuiTheme = imuiTheme || {};
imuiTheme.content = {
  getHeight: function() {
    var contentHeight = jQuery(window).height() - jQuery('#imui-header').outerHeight(true) - jQuery('#imui-footer').outerHeight(true);
    return contentHeight;
  },
  getWidth: function() {
    var contentWidth = jQuery(window).width();
    return contentWidth;
  }
};
(function($) {
    $(document).ready(function() {
        //iframe のコンテンツ読み込みが終了したら、iframe 内の min-width を window の幅にする
        $($('#IM_MAIN')).load(function () {
          try {
            if ($('#IM_MAIN').get(0).contentDocument && $("#IM_MAIN").contents().find('body').css('min-width') > $(window).width()) {
              $("#IM_MAIN").contents().find('body').css('min-width', $(window).width());
              $("#IM_MAIN").contents().find('#imui-container').css('min-width', $(window).width());
            }
          } catch(ignore) {
          }
        });

        fitIframe();
        $(window).resize(fitIframe);
    });
    function fitIframe() {
        // iframe#IM_MAIN が存在する場合、親の min-height を削除。
        if ($('#IM_MAIN').length > 0) {
          $('#imui-container').css('min-height', '0px');
        }
        // iframe のデフォルト値 display:inline だと（おそらく）文字のディセンダ分だけ高さがずれてしまうので block に変更します。
        $('#IM_MAIN').css('display','block');

        var height = $(window).height() - $('#imui-header').outerHeight(true) - $('#imui-footer').outerHeight(true);
        $('#IM_MAIN').find('iframe:not(".imui-no-resize-iframe")').height(height).width($(window).width());
        $('#IM_MAIN').height(height).width($(window).width());
    }
})(jQuery);
