(function($) {
    $.widget("imui.imuiSearchBox", {
        active: false,
        _create: function() {
            var self = this;

            var form = $(this.element).find('form');
            var trigger = $(this.element).find('li.imui-nav-global-search');
            self.formArea = form;
            self._close();
            trigger.children('a').bind('click', function() {
                if (self.active) {
                    self._close();
                    this.focus();
                } else {
                    self._open();
                    self.formArea.find('.imui-form-global-search-input').focus();
                }
                return false;
            });
            form.bind('submit', function() {
                if (self.active) {
                    self._close();
                }
            });
        },
        _open: function() {
            var form = $(this.element).find('form');
            form.children("input").remove();
            if (localStorage) {
                var settings = JSON.parse(localStorage.getItem("imcs_search_settings"));
                for(var key in settings) {
                    $("<input />").attr({"type" : "hidden", "name" : key, "value" : settings[key]}).appendTo(form);
                }
            }
            this.active = true;
            $(this.element.children('li')).addClass('active');
            this.formArea.show();
        },
        _close: function() {
            this.active = false;
            $(this.element.children('li')).removeClass('active');
            this.formArea.hide();
        }
    });
