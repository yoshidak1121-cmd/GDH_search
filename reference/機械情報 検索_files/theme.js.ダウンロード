      var buttons = 'button, input[type="button"], button.ui-button, input.ui-button, button.imui-button, button.imui-small-button, button.imui-medium-button, button.imui-large-button , input[type="button"].imui-button, input[type="button"].imui-small-button, input[type="button"].imui-medium-button, input[type="button"].imui-large-button';
      $(buttons).on('mouseup.imuiRippleButton.on', createRipple);
      $(document).on('mouseup.imuiRippleButton.live', buttons, createRipple); // 後から追加されたボタン用

      function createRipple(event,pageX,pageY) {
        var _this = $(this);
        // 二回目は無視
        if(_this.hasClass('imui-ripple-body')) {
          _this.removeClass('imui-ripple-body');
          return false;
        }
        // 非表示の要素、非活性の要素、非活性に見えるスタイルが付与されている場合は処理を行わない
        if (_this.is(':hidden') || _this.prop('disabled') || _this.hasClass('ui-state-disabled') || _this.hasClass('imui-disabled-button')) {
          return false;
        }
        event.preventDefault();
        _this.addClass('imui-ripple-body');
        var inner = $('<div/>');
        var zIndex = _this.zIndex();
        var outer = $('<div class="imui-ripple" style="z-index:' + zIndex + ';"/>');
        var btnOffset = _this.offset();
        var yPos = event.pageY- btnOffset.top;
        var xPos = event.pageX - btnOffset.left;
        if (event.isTrigger) {
          yPos = pageY- btnOffset.top;
          xPos = pageX - btnOffset.left;
        }
        inner.addClass('imui-ripple-effect');
        inner.css({
          top: yPos - 25, // TODO .imui-ripple-effect 要素の半分
          left: xPos - 25 // TODO .imui-ripple-effect 要素の半分
        });
        outer.width(_this.outerWidth());
        outer.height(_this.outerHeight());
        outer.offset({ top: btnOffset.top, left: btnOffset.left });
        outer.append(inner);
        outer.appendTo('body');
        var intervalId = setInterval(function() {
          if(_this.length < 1 || _this.is(':hidden')) {
            _this.removeClass('imui-ripple-body');
            clearInterval(intervalId);
            outer.remove();
            return;
          }
          outer.offset({ top: _this.offset().top, left: _this.offset().left })
        }, 30) //繰り返し実行する間隔

        // 下の要素の click イベントを発火します
        outer.on('click.imuiRippleButton',function(e) {
          _this.removeClass('imui-ripple-body');
          $(this).remove();
          clearInterval(intervalId);
          _this.click();
          _this.trigger('mouseup',[e.pageX,e.pageY]); // マウスの位置情報を引数に追加してイベントを呼び出す
        }).on('mousedown', function(e) {
            if (e.preventDefault != null) {
              e.preventDefault();
            }
            if (e.stopPropagation != null) {
              e.stopPropagation();
            }
        })
        // アニメーション終了時に要素を削除します
        outer.on('animationend',function() {
          _this.removeClass('imui-ripple-body');
          $(this).remove();
          clearInterval(intervalId);
        });
      }
      // ここまで
    });
